<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Moorings</AssemblyName>
    <RootNamespace>Moorings</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ValheimDir>$(HOME)/.steam/steam/steamapps/common/Valheim</ValheimDir>
    <ProfileDir>$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/Default</ProfileDir>
    <BepInExDir>$(ProfileDir)/BepInEx</BepInExDir>
    <PluginOut>$(BepInExDir)/plugins/Moorings</PluginOut>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="Jotunn"><HintPath>$(BepInExDir)/plugins/ValheimModding-Jotunn/Jotunn.dll</HintPath></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimDir)/valheim_Data/Managed/assembly_valheim.dll</HintPath></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimDir)/valheim_Data/Managed/assembly_utils.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimDir)/valheim_Data/Managed/UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimDir)/valheim_Data/Managed/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ValheimDir)/valheim_Data/Managed/UnityEngine.AssetBundleModule.dll</HintPath></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ValheimDir)/valheim_Data/Managed/assembly_guiutils.dll</HintPath></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ValheimDir)/valheim_Data/Managed/UnityEngine.PhysicsModule.dll</HintPath></Reference>
  </ItemGroup>

  <!-- Drop the built DLL straight into the r2modman profile so launching the game tests it -->
  <Target Name="Deploy" AfterTargets="Build">
    <MakeDir Directories="$(PluginOut)" />
    <Copy SourceFiles="$(OutDir)/Moorings.dll" DestinationFolder="$(PluginOut)" />
  </Target>
</Project>
